# ---------------------------------------------------------------------
#  Outline - konfigurasi (mode lokal, akses via port, tanpa SSL)
#  Referensi: https://github.com/outline/outline/blob/main/.env.sample
# ---------------------------------------------------------------------

NODE_ENV=production

# URL harus sama persis dengan alamat yang dibuka di browser
URL=http://localhost:8070
PORT=3000
FORCE_HTTPS=false

# Secret (openssl rand -hex 32)
SECRET_KEY=ganti_dengan_openssl_rand_hex_32
UTILS_SECRET=ganti_dengan_openssl_rand_hex_32

DEFAULT_LANGUAGE=id_ID

# --- PostgreSQL (dipakai container postgres) ---
POSTGRES_USER=postgre
POSTGRES_PASSWORD=ganti_password
POSTGRES_DB=outline_db

# --- Koneksi dari Outline (user/password/db harus sama dengan di atas) ---
DATABASE_URL=postgres://postgre:ganti_password@postgres:5432/outline_db
PGSSLMODE=disable

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Penyimpanan file lokal ---
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# --- Penyedia login (isi minimal satu, lihat README bagian 5) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTH_URI=
# OIDC_TOKEN_URI=
# OIDC_USERINFO_URI=
# OIDC_LOGOUT_URI=
# OIDC_DISPLAY_NAME=OpenID Connect
# OIDC_SCOPES=openid profile email
